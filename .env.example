# ─────────────────────────────────────────────────────────────────────────────
#  PLANTILLA DE VARIABLES DE ENTORNO — DrReceta_Agente (API NestJS)
#
#  Copiá este archivo a `.env` y completá los valores:
#      cp .env.example .env
#
#  `.env` está en `.gitignore`: NUNCA subas claves reales al repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────────────────────
# Puerto del API. El 3000 lo ocupa el frontend Next.js (medical_front), por eso
# el agente escucha en 3001. Override con `PORT=xxxx npm start`.
PORT=3001

# ── Modelo (endpoint Anthropic-compatible de MiniMax) ─────────────────────
# El SDK de Anthropic se apunta al endpoint Anthropic-compatible de MiniMax
# para que el razonamiento (`type: "thinking"`) llegue separado del texto.
ANTHROPIC_API_KEY=sk-cp-REPLACE
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_MODEL=MiniMax-M3

# Fallback legacy OpenAI-compatible (no se usa en el flujo activo).
MINIMAX_API_KEY=sk-cp-REPLACE
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ── Base de datos (SQL Server del agente) ───────────────────────────────────
# SQL Server (mssql). El agente crea sus propias tablas (historial_mensajes,
# memoria_largo_plazo, chats_pausados, conocimiento_especifico...).
# Si no se define NINGUNA de estas variables, la app arranca igual pero sin
# persistencia (historial, memoria, pausa y auto-resume deshabilitados).
DB_SERVER=192.168.100.133
DB_PORT=1433
DB_NAME=MEDICA4
DB_USER=sa
DB_PASSWORD=sa
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Alternativa a lo anterior (tiene prioridad si está definida):
# DB_CONNECTION_STRING=Server=192.168.100.133;Database=MEDICA4;User Id=sa;Password=sa;Encrypt=True;TrustServerCertificate=True;

# ── APIs externas (Audita) ─────────────────────────────────────────────────
# Base de los endpoints en src/api/urls.ts.
AUDITA_API_URL=https://auditta-backendauditta-yffe9d-1c109a-179-197-82-76.sslip.io

# ── Ollama (modelo local, opcional) ────────────────────────────────────────
OLLAMA_MODEL=gemma3:4b

# ── Comportamiento ─────────────────────────────────────────────────────────
# Minutos sin respuesta del humano antes de auto-reanudar el chat.
HUMAN_TIMEOUT_MINUTES=5

# Log de las llamadas a las APIs externas (src/api/api-logger.ts).
# API_LOG=false apaga el log por completo (útil en Docker).
API_LOG=true
# API_LOG_COLOR=false desactiva el color (auto por defecto: color solo con TTY).
API_LOG_PREVIEW=1200
API_LOG_PREVIEW_REQUEST=4000
