# Environment Configuration for Doctor Recetas API

# ── Existing ──────────────────────────────────────────────────────────────────
# Twilio Voice Integration (legacy TwiML + new SIP)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1787558xxxx

# API URL (for webhooks)
API_URL=https://your-api-domain.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/doctor_recetas

# Claude/Anthropic
ANTHROPIC_API_KEY=your_api_key_here

# WhatsApp Web (if using)
WHATSAPP_WEBHOOK_URL=http://localhost:3000/whatsapp/webhook

# Chat Service
CHAT_API_URL=http://localhost:5000

# Ollama (if using local LLM)
OLLAMA_API_URL=http://localhost:11434

# Node Environment
NODE_ENV=development


# ── Voice Agent Stack (Fase 1+) ──────────────────────────────────────────────

# LiveKit server
# URL pública con WSS para que el agente se conecte
LIVEKIT_URL=wss://livekit.your-domain.com
# Clave pública que el cliente/SDK envía en tokens
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxx
# Secret para firmar tokens JWT. Generar con: openssl rand -hex 32
LIVEKIT_API_SECRET=replace-with-32-byte-hex-secret
# Dominio público de LiveKit (debe coincidir con el cert TLS)
LIVEKIT_DOMAIN=livekit.your-domain.com
# IP pública del VPS donde corre LiveKit (para SIP signaling)
LIVEKIT_SIP_NODE_IP=203.0.113.10
# ID del SIP trunk (se crea dinámicamente en Fase 5, dejar vacío por ahora)
LIVEKIT_SIP_TRUNK_ID=ST_BfXLtipGPjdq

# Twilio SIP (nuevo flujo, paralelo al TwiML legacy)
# Dominio SIP que Twilio usará para entregar llamadas a LiveKit
TWILIO_SIP_TRUNK_DOMAIN=sip.your-domain.com
TWILIO_SIP_USERNAME=twilio_trunk_user
TWILIO_SIP_PASSWORD=replace-with-strong-password

# OpenAI (STT + TTS para el voice agent)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
# Opciones: alloy, echo, fable, onyx, nova, shimmer
# nova y shimmer suenan mejor en español
OPENAI_TTS_VOICE=nova

# Redis (sesiones de llamada, contexto conversacional)
REDIS_URL=redis://localhost:6379

# Recording (LiveKit Egress → filesystem local)
RECORDINGS_DIR=./recordings
RECORDINGS_RETENTION_DAYS=30

# Voice behavior
VOICE_LANGUAGE=es-ES
VOICE_AGENT_NAME=Isla
VOICE_GREETING=Hola, soy Isla, asistente de IslandMedPR. ¿En qué puedo ayudarte?
